{
  "manifest_version": 3,
  "name": "Text Capture Translator",
  "version": "1.0.0",
  "description": "Select images on a page, extract text with OCR, and translate it.",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["activeTab"],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:8080/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["capture.js"],
      "run_at": "document_idle"
    }
  ]
}